{% extends 'layouts/master' %}

{% block title %}{{ product.name }} — {{ store.name }}{% endblock %}
{% block description %}{{ product.description | striptags | slice(0, 160) }}{% endblock %}
{% block og_type %}product{% endblock %}
{% block og_image %}{{ product.thumbnail }}{% endblock %}

{% block body_class %}page-product{% endblock %}

{% block head %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Product",
  "name": "{{ product.name | e('js') }}",
  "description": "{{ product.description | striptags | e('js') }}",
  "image": "{{ product.thumbnail }}",
  "brand": { "@type": "Brand", "name": "{{ product.brand.name | default(store.name) }}" },
  "offers": {
    "@type": "Offer",
    "price": "{{ product.price.amount }}",
    "priceCurrency": "{{ store.currency.code }}",
    "availability": "{{ product.is_out_of_stock ? 'OutOfStock' : 'InStock' }}"
  },
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "{{ product.rating.avg | default(5) }}",
    "reviewCount": "{{ product.rating.count | default(0) }}"
  }
}
</script>
{% endblock %}

{% block content %}
<div class="container">

  {# Breadcrumb #}
  <nav class="breadcrumb" aria-label="{{ 'مسار التنقل' | trans }}">
    <div class="breadcrumb__item">
      <a href="{{ store.url }}">{{ 'الرئيسية' | trans }}</a>
      <span class="breadcrumb__sep" aria-hidden="true">›</span>
    </div>
    {% if product.category %}
      <div class="breadcrumb__item">
        <a href="{{ product.category.url }}">{{ product.category.name }}</a>
        <span class="breadcrumb__sep" aria-hidden="true">›</span>
      </div>
    {% endif %}
    <div class="breadcrumb__item" aria-current="page">{{ product.name }}</div>
  </nav>

  {# Product Layout #}
  <div class="product-layout" itemscope itemtype="https://schema.org/Product">

    {# ═══ Gallery ═══ #}
    <div class="product-gallery">
      <div class="product-gallery__main" id="gallery-main" role="img" aria-label="{{ product.name }}">
        <img
          src="{{ product.thumbnail }}"
          alt="{{ product.name }}"
          id="gallery-main-img"
          width="600"
          height="600"
          loading="eager"
          fetchpriority="high"
          itemprop="image"
        >
        <button class="product-gallery__zoom-btn" id="lightbox-open" aria-label="{{ 'تكبير الصورة' | trans }}">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" width="18" height="18" aria-hidden="true">
            <path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7" stroke-linecap="round"/>
          </svg>
        </button>
      </div>

      <div class="product-gallery__thumbs" role="list" aria-label="{{ 'صور المنتج' | trans }}">
        {% for image in product.images %}
          <button
            class="product-gallery__thumb{% if loop.first %} active{% endif %}"
            data-src="{{ image.url }}"
            data-index="{{ loop.index0 }}"
            aria-label="{{ 'صورة' | trans }} {{ loop.index }}"
            role="listitem"
          >
            <img src="{{ image.url }}" alt="{{ product.name }} — {{ loop.index }}" loading="lazy">
          </button>
        {% endfor %}
      </div>
    </div>

    {# ═══ Product Info ═══ #}
    <div class="product-info">
      {% if product.brand %}
        <p class="product-info__brand" itemprop="brand">{{ product.brand.name }}</p>
      {% endif %}

      <h1 class="product-info__title" itemprop="name">{{ product.name }}</h1>

      {# Rating Row #}
      {% if product.rating.count > 0 %}
        <div class="product-info__rating-row">
          <div class="rating" aria-label="{{ product.rating.avg }} {{ 'نجوم' | trans }}">
            {% for i in 1..5 %}
              <svg viewBox="0 0 24 24" fill="{{ i <= product.rating.avg ? 'currentColor' : 'none' }}" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
              </svg>
            {% endfor %}
            <span class="rating__count">({{ product.rating.count }})</span>
          </div>
          <a href="#reviews" class="product-info__reviews-link">
            {{ product.rating.count }} {{ 'تقييم' | trans }}
          </a>
          <span style="color:var(--color-border)">|</span>
          <span style="font-size:.85rem;color:var(--color-text-muted)">
            {{ 'رقم المنتج:' | trans }} {{ product.sku }}
          </span>
        </div>
      {% endif %}

      {# Price #}
      <div class="product-info__price-block">
        {% if product.sale_price %}
          <span class="product-info__price-old num">{{ product.regular_price.formatted }}</span>
          <span class="product-info__price-main num" itemprop="price" content="{{ product.sale_price.amount }}">{{ product.sale_price.formatted }}</span>
          <span class="product-info__discount-badge">{{ 'خصم' | trans }} {{ product.discount_percent }}%</span>
        {% else %}
          <span class="product-info__price-main num" itemprop="price" content="{{ product.price.amount }}">{{ product.price.formatted }}</span>
        {% endif %}
        <meta itemprop="priceCurrency" content="{{ store.currency.code }}">
        <meta itemprop="availability" content="{{ product.is_out_of_stock ? 'OutOfStock' : 'InStock' }}">
      </div>

      {# Installment badges #}
      {% if settings.show_tabby and product.price.amount >= 200 %}
        <div class="installment-badge">
          <img src="{{ theme.url }}/assets/images/payment/tabby.svg" alt="Tabby" height="18">
          <span>{{ 'أو' | trans }} 4 × {{ (product.price.amount / 4) | number_format(2) }} {{ store.currency.symbol }} {{ 'مع تابي' | trans }}</span>
        </div>
      {% endif %}
      {% if settings.show_tamara and product.price.amount >= 200 %}
        <div class="installment-badge">
          <img src="{{ theme.url }}/assets/images/payment/tamara.svg" alt="Tamara" height="18">
          <span>{{ 'أو' | trans }} 3 × {{ (product.price.amount / 3) | number_format(2) }} {{ store.currency.symbol }} {{ 'مع تمارا' | trans }}</span>
        </div>
      {% endif %}

      {# Flash Offer Timer #}
      {% if product.sale_ends_at %}
        <div class="product-info__flash-timer">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
            <circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>
          </svg>
          <div>
            <p>{{ 'ينتهي العرض خلال:' | trans }}</p>
            <div
              class="countdown-timer"
              data-countdown="{{ product.sale_ends_at }}"
              style="color:var(--color-primary)"
              aria-live="polite"
            >
              <span data-countdown-hours class="num">00</span>:
              <span data-countdown-minutes class="num">00</span>:
              <span data-countdown-seconds class="num">00</span>
            </div>
          </div>
        </div>
      {% endif %}

      {# Variants #}
      {% if product.options | length > 0 %}
        {% for option in product.options %}
          <div class="variant-selector">
            <p class="variant-selector__label">
              {{ option.name }}:
              <span class="selected-value" data-option-selected="{{ option.id }}"></span>
            </p>

            {% if option.type == 'color' %}
              <div class="variant-selector__colors" role="group" aria-label="{{ option.name }}">
                {% for value in option.values %}
                  <button
                    class="variant-selector__color{% if value.is_out_of_stock %} out-of-stock{% endif %}"
                    style="background: {{ value.color | default('#ccc') }}"
                    data-option-value="{{ value.id }}"
                    data-option-id="{{ option.id }}"
                    title="{{ value.name }}"
                    aria-label="{{ value.name }}"
                    {% if value.is_out_of_stock %}aria-disabled="true"{% endif %}
                  ></button>
                {% endfor %}
              </div>
            {% else %}
              <div class="variant-selector__sizes" role="group" aria-label="{{ option.name }}">
                {% for value in option.values %}
                  <button
                    class="variant-selector__size{% if value.is_out_of_stock %} out-of-stock{% endif %}"
                    data-option-value="{{ value.id }}"
                    data-option-id="{{ option.id }}"
                    {% if value.is_out_of_stock %}aria-disabled="true" title="{{ 'غير متوفر' | trans }}"{% endif %}
                  >
                    {{ value.name }}
                  </button>
                {% endfor %}
              </div>
            {% endif %}
          </div>
        {% endfor %}
      {% endif %}

      {# Quantity #}
      <div style="margin-bottom:var(--space-5)">
        <p style="font-size:.875rem;font-weight:700;margin-bottom:var(--space-3)">{{ 'الكمية' | trans }}</p>
        <div class="quantity-input" aria-label="{{ 'الكمية' | trans }}">
          <button id="qty-minus" aria-label="{{ 'تقليل الكمية' | trans }}">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12" stroke-linecap="round"/></svg>
          </button>
          <input type="number" id="product-qty" value="1" min="1" max="{{ product.max_quantity | default(99) }}" aria-label="{{ 'الكمية' | trans }}" readonly>
          <button id="qty-plus" aria-label="{{ 'زيادة الكمية' | trans }}">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><line x1="12" y1="5" x2="12" y2="19" stroke-linecap="round"/><line x1="5" y1="12" x2="19" y2="12" stroke-linecap="round"/></svg>
          </button>
        </div>
        {% if product.quantity > 0 %}
          <p style="font-size:.8rem;color:var(--color-success);margin-top:var(--space-2)">
            ✓ {{ 'متوفر في المخزون' | trans }}
          </p>
        {% endif %}
      </div>

      {# CTA Buttons #}
      <div class="product-info__actions">
        <div class="product-info__btn-row">
          {% if not product.is_out_of_stock %}
            <button
              class="btn btn--primary btn--lg"
              id="add-to-cart-main"
              data-product-id="{{ product.id }}"
              aria-label="{{ 'أضف إلى السلة' | trans }}"
            >
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="20" height="20" aria-hidden="true">
                <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/>
              </svg>
              {{ 'أضف إلى السلة' | trans }}
            </button>
            <a
              href="{{ product.checkout_url }}"
              class="btn btn--accent btn--full btn--lg"
              aria-label="{{ 'اشتر الآن' | trans }}"
            >
              {{ 'اشتر الآن' | trans }}
            </a>
          {% else %}
            <button class="btn btn--outline btn--full btn--lg" disabled aria-disabled="true">
              {{ 'نفد المخزون' | trans }}
            </button>
          {% endif %}
        </div>
      </div>

      {# Social Actions #}
      <div class="product-info__social-actions">
        <button
          data-wishlist-toggle="{{ product.id }}"
          data-wishlist-id="{{ product.id }}"
          aria-label="{% if product.in_wishlist %}{{ 'إزالة من المفضلة' | trans }}{% else %}{{ 'أضف للمفضلة' | trans }}{% endif %}"
          aria-pressed="{{ product.in_wishlist ? 'true' : 'false' }}"
        >
          <svg viewBox="0 0 24 24" fill="{% if product.in_wishlist %}currentColor{% else %}none{% endif %}" stroke="currentColor" stroke-width="1.8" width="18" height="18" aria-hidden="true">
            <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
          </svg>
          {{ 'أضف للمفضلة' | trans }}
        </button>

        <button data-compare="{{ product.id }}" aria-label="{{ 'مقارنة المنتج' | trans }}">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" width="18" height="18" aria-hidden="true">
            <path d="M8 6h13M8 12h13M8 18h13M3 6h.01M3 12h.01M3 18h.01" stroke-linecap="round"/>
          </svg>
          {{ 'مقارنة' | trans }}
        </button>

        <a href="https://wa.me/?text={{ product.name | url_encode }}%20{{ product.url | url_encode }}" target="_blank" rel="noopener" aria-label="{{ 'مشاركة عبر واتساب' | trans }}">
          <svg viewBox="0 0 24 24" fill="currentColor" width="18" height="18" aria-hidden="true">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/>
            <path d="M12 0C5.373 0 0 5.373 0 12c0 2.099.543 4.07 1.49 5.784L0 24l6.41-1.461A11.94 11.94 0 0 0 12 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 22c-1.856 0-3.59-.503-5.076-1.38l-.36-.213-3.805.868.94-3.698-.237-.382A9.96 9.96 0 0 1 2 12C2 6.477 6.477 2 12 2s10 4.477 10 10-4.477 10-10 10z"/>
          </svg>
          {{ 'مشاركة' | trans }}
        </a>
      </div>

    </div>{# /.product-info #}
  </div>{# /.product-layout #}

  {# ═══ Product Tabs ═══ #}
  <div class="product-tabs">
    <div class="product-tabs__nav" role="tablist">
      <button class="product-tabs__tab active" role="tab" aria-selected="true"  aria-controls="tab-desc"    id="tab-btn-desc">{{ 'الوصف' | trans }}</button>
      <button class="product-tabs__tab"         role="tab" aria-selected="false" aria-controls="tab-specs"   id="tab-btn-specs">{{ 'المواصفات' | trans }}</button>
      <button class="product-tabs__tab"         role="tab" aria-selected="false" aria-controls="tab-reviews" id="tab-btn-reviews">{{ 'التقييمات' | trans }} ({{ product.rating.count }})</button>
      <button class="product-tabs__tab"         role="tab" aria-selected="false" aria-controls="tab-shipping" id="tab-btn-shipping">{{ 'الشحن والإرجاع' | trans }}</button>
    </div>

    <div class="product-tabs__panel active" role="tabpanel" id="tab-desc" aria-labelledby="tab-btn-desc" tabindex="0">
      <div class="prose" itemprop="description">{{ product.description | raw }}</div>
    </div>

    <div class="product-tabs__panel" role="tabpanel" id="tab-specs" aria-labelledby="tab-btn-specs" tabindex="0">
      {% if product.properties | length > 0 %}
        <table class="specs-table">
          <tbody>
            {% for prop in product.properties %}
              <tr>
                <th>{{ prop.name }}</th>
                <td>{{ prop.value }}</td>
              </tr>
            {% endfor %}
          </tbody>
        </table>
      {% else %}
        <p style="color:var(--color-text-muted)">{{ 'لا توجد مواصفات متاحة.' | trans }}</p>
      {% endif %}
    </div>

    <div class="product-tabs__panel" role="tabpanel" id="tab-reviews" aria-labelledby="tab-btn-reviews" tabindex="0" id="reviews">
      {# Salla Reviews integration #}
      <salla-reviews product-id="{{ product.id }}"></salla-reviews>
    </div>

    <div class="product-tabs__panel" role="tabpanel" id="tab-shipping" aria-labelledby="tab-btn-shipping" tabindex="0">
      <div style="max-width:600px">
        <h3 style="margin-bottom:var(--space-4)">{{ 'معلومات الشحن' | trans }}</h3>
        <p style="color:var(--color-text-muted);line-height:1.8;margin-bottom:var(--space-4)">
          {{ 'نوفر خدمة الشحن السريع لجميع مناطق المملكة العربية السعودية ودول الخليج. يتم الشحن خلال 2-5 أيام عمل.' | trans }}
        </p>
        <h3 style="margin-bottom:var(--space-4)">{{ 'سياسة الإرجاع' | trans }}</h3>
        <p style="color:var(--color-text-muted);line-height:1.8">
          {{ 'يمكنك إرجاع المنتج خلال 14 يوماً من تاريخ الاستلام بشرط أن يكون بحالته الأصلية وبعبوته الأصلية.' | trans }}
        </p>
      </div>
    </div>
  </div>

  {# ═══ Related Products ═══ #}
  {% if product.related_products | length > 0 %}
    <section class="section" aria-labelledby="related-title">
      <div class="section-header">
        <h2 class="section-title" id="related-title">{{ 'منتجات مشابهة' | trans }}</h2>
      </div>
      <div class="products-grid">
        {% for related in product.related_products | slice(0, 4) %}
          {% set product = related %}
          {% include 'components/product-card' %}
        {% endfor %}
      </div>
    </section>
  {% endif %}

</div>{# /.container #}

{# Lightbox #}
<div class="lightbox" id="lightbox" role="dialog" aria-label="{{ 'عرض الصورة' | trans }}" aria-modal="true">
  <button class="lightbox__close" id="lightbox-close" aria-label="{{ 'إغلاق' | trans }}">
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
      <path d="M18 6L6 18M6 6l12 12" stroke-linecap="round"/>
    </svg>
  </button>
  <img class="lightbox__image" id="lightbox-img" src="" alt="{{ product.name }}">
  <button class="lightbox__nav lightbox__nav--prev" id="lightbox-prev" aria-label="{{ 'السابق' | trans }}">
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
      <path d="M15 18l-6-6 6-6" stroke-linecap="round"/>
    </svg>
  </button>
  <button class="lightbox__nav lightbox__nav--next" id="lightbox-next" aria-label="{{ 'التالي' | trans }}">
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
      <path d="M9 18l6-6-6-6" stroke-linecap="round"/>
    </svg>
  </button>
</div>
{% endblock %}

{% block scripts %}
<script>
(function() {

  // Gallery
  const thumbs = document.querySelectorAll('.product-gallery__thumb');
  const mainImg = document.getElementById('gallery-main-img');

  thumbs.forEach(function(thumb) {
    thumb.addEventListener('click', function() {
      mainImg.src = this.dataset.src;
      thumbs.forEach(t => t.classList.remove('active'));
      this.classList.add('active');
    });
  });

  // Lightbox
  const allImages = Array.from(thumbs).map(t => t.dataset.src);
  let currentIdx = 0;

  document.getElementById('lightbox-open')?.addEventListener('click', function() {
    currentIdx = parseInt(document.querySelector('.product-gallery__thumb.active')?.dataset.index || 0);
    document.getElementById('lightbox-img').src = allImages[currentIdx];
    document.getElementById('lightbox').classList.add('open');
    document.getElementById('lightbox').removeAttribute('aria-hidden');
    document.getElementById('lightbox-close').focus();
  });

  document.getElementById('lightbox-close')?.addEventListener('click', function() {
    document.getElementById('lightbox').classList.remove('open');
    document.getElementById('lightbox').setAttribute('aria-hidden', 'true');
  });

  document.getElementById('lightbox-prev')?.addEventListener('click', function() {
    currentIdx = (currentIdx - 1 + allImages.length) % allImages.length;
    document.getElementById('lightbox-img').src = allImages[currentIdx];
  });

  document.getElementById('lightbox-next')?.addEventListener('click', function() {
    currentIdx = (currentIdx + 1) % allImages.length;
    document.getElementById('lightbox-img').src = allImages[currentIdx];
  });

  // Quantity
  const qtyInput = document.getElementById('product-qty');
  document.getElementById('qty-plus')?.addEventListener('click', function() {
    qtyInput.value = Math.min(parseInt(qtyInput.value) + 1, parseInt(qtyInput.max));
  });
  document.getElementById('qty-minus')?.addEventListener('click', function() {
    qtyInput.value = Math.max(parseInt(qtyInput.value) - 1, 1);
  });

  // Add to cart
  document.getElementById('add-to-cart-main')?.addEventListener('click', async function() {
    const btn = this;
    btn.classList.add('loading');
    try {
      await Salla.cart.add({
        product_id: btn.dataset.productId,
        quantity:   parseInt(qtyInput?.value || 1),
      });
      btn.textContent = '✓ {{ 'تمت الإضافة!' | trans }}';
      setTimeout(() => { btn.classList.remove('loading'); btn.innerHTML = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="20" height="20"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/></svg> {{ 'أضف إلى السلة' | trans }}'; }, 2000);
    } catch(e) {
      btn.classList.remove('loading');
    }
  });

  // Tabs
  document.querySelectorAll('.product-tabs__tab').forEach(function(tab) {
    tab.addEventListener('click', function() {
      document.querySelectorAll('.product-tabs__tab').forEach(t => { t.classList.remove('active'); t.setAttribute('aria-selected','false'); });
      document.querySelectorAll('.product-tabs__panel').forEach(p => p.classList.remove('active'));
      this.classList.add('active');
      this.setAttribute('aria-selected','true');
      document.getElementById(this.getAttribute('aria-controls'))?.classList.add('active');
    });
    tab.addEventListener('keydown', function(e) {
      if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); this.click(); }
    });
  });

  // Variant selection
  document.querySelectorAll('[data-option-value]').forEach(function(btn) {
    btn.addEventListener('click', function() {
      if (this.classList.contains('out-of-stock')) return;
      const optionId = this.dataset.optionId;
      document.querySelectorAll(`[data-option-id="${optionId}"]`).forEach(b => b.classList.remove('selected'));
      this.classList.add('selected');
      const labelEl = document.querySelector(`[data-option-selected="${optionId}"]`);
      if (labelEl) labelEl.textContent = this.title || this.textContent;
    });
  });

})();
</script>
{% endblock %}
