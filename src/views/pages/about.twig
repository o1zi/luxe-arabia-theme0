{% extends 'layouts/master' %}
{% block title %}{{ 'عن المتجر' | trans }} — {{ store.name }}{% endblock %}
{% block body_class %}page-about{% endblock %}

{% block content %}

  {# Hero #}
  <div style="background:var(--color-primary);padding:var(--space-10) 0;text-align:center;position:relative;overflow:hidden">
    <div style="position:absolute;inset:0;opacity:.05;background:radial-gradient(circle at 20% 50%, var(--color-accent) 0%, transparent 60%)" aria-hidden="true"></div>
    <div class="container" style="position:relative">
      <span class="section-label" style="color:var(--color-accent)">{{ 'قصتنا' | trans }}</span>
      <h1 style="font-size:clamp(2rem,5vw,3rem);font-weight:900;color:#fff;margin-top:var(--space-2)">{{ 'عن ' ~ store.name }}</h1>
      {% if store.slogan %}
        <p style="color:rgba(255,255,255,.7);font-size:1.125rem;margin-top:var(--space-3)">{{ store.slogan }}</p>
      {% endif %}
    </div>
  </div>

  {# Story Section #}
  <section class="section">
    <div class="container">
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:var(--space-9);align-items:center">
        <div>
          <span class="section-label">{{ 'من نحن' | trans }}</span>
          <h2 style="font-size:clamp(1.5rem,3vw,2rem);font-weight:900;color:var(--color-primary);margin-block:var(--space-3) var(--space-4)">{{ 'رحلة نحو التميز' | trans }}</h2>
          <div style="color:var(--color-text-muted);line-height:2">
            {{ store.description | default('منذ تأسيسنا، ونحن نسعى جاهدين لتقديم أفضل تجربة تسوق إلكتروني في المنطقة العربية. نؤمن بأن التسوق يجب أن يكون ممتعاً وسهلاً وآمناً.') }}
          </div>
          <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:var(--space-5);margin-top:var(--space-7);text-align:center">
            <div style="padding:var(--space-5);background:var(--color-secondary);border-radius:var(--radius-lg)">
              <p style="font-size:2rem;font-weight:900;color:var(--color-accent)">+5K</p>
              <p style="font-size:.85rem;color:var(--color-text-muted);margin-top:var(--space-1)">{{ 'منتج متميز' | trans }}</p>
            </div>
            <div style="padding:var(--space-5);background:var(--color-secondary);border-radius:var(--radius-lg)">
              <p style="font-size:2rem;font-weight:900;color:var(--color-accent)">+50K</p>
              <p style="font-size:.85rem;color:var(--color-text-muted);margin-top:var(--space-1)">{{ 'عميل سعيد' | trans }}</p>
            </div>
            <div style="padding:var(--space-5);background:var(--color-secondary);border-radius:var(--radius-lg)">
              <p style="font-size:2rem;font-weight:900;color:var(--color-accent)">4.9★</p>
              <p style="font-size:.85rem;color:var(--color-text-muted);margin-top:var(--space-1)">{{ 'تقييم المتجر' | trans }}</p>
            </div>
          </div>
        </div>
        <div style="border-radius:var(--radius-xl);overflow:hidden;aspect-ratio:4/3;background:var(--color-bg-alt)">
          {% if store.cover %}
            <img src="{{ store.cover }}" alt="{{ store.name }}" style="width:100%;height:100%;object-fit:cover" loading="lazy">
          {% else %}
            <div style="width:100%;height:100%;display:flex;align-items:center;justify-content:center;background:var(--color-secondary)">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" width="80" height="80" style="color:var(--color-border)" aria-hidden="true">
                <rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8M12 17v4"/>
              </svg>
            </div>
          {% endif %}
        </div>
      </div>
    </div>
  </section>

  {# Values #}
  <section class="section" style="background:var(--color-secondary)">
    <div class="container">
      <div class="section-header">
        <span class="section-label">{{ 'ما يميزنا' | trans }}</span>
        <h2 class="section-title">{{ 'قيمنا ومبادئنا' | trans }}</h2>
      </div>
      <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:var(--space-5)">
        {% set values = [
          { icon: 'icon-shield',  title: 'الجودة أولاً',    desc: 'نختار منتجاتنا بعناية شديدة لنضمن أعلى مستويات الجودة.' },
          { icon: 'icon-truck',   title: 'شحن سريع',        desc: 'نوصل طلبك في أسرع وقت ممكن لأي مكان في المنطقة.' },
          { icon: 'icon-refresh', title: 'إرجاع مضمون',     desc: 'نضمن رضاك التام أو نسترجع المبلغ كاملاً.' },
          { icon: 'icon-card',    title: 'دفع آمن',         desc: 'جميع معاملاتك محمية بأحدث تقنيات التشفير.' },
        ] %}
        {% for val in values %}
          <div style="background:var(--color-bg);border-radius:var(--radius-xl);padding:var(--space-6);text-align:center">
            <div style="width:64px;height:64px;border-radius:var(--radius-lg);background:linear-gradient(135deg,var(--color-primary),#2A2A4E);display:flex;align-items:center;justify-content:center;margin:0 auto var(--space-4)">
              <svg width="28" height="28" fill="none" stroke="var(--color-accent)" stroke-width="1.8" aria-hidden="true">
                <use href="#{{ val.icon }}"/>
              </svg>
            </div>
            <h3 style="font-size:1rem;font-weight:800;margin-bottom:var(--space-2)">{{ val.title | trans }}</h3>
            <p style="font-size:.875rem;color:var(--color-text-muted);line-height:1.7">{{ val.desc | trans }}</p>
          </div>
        {% endfor %}
      </div>
    </div>
  </section>

  {# CTA #}
  <section class="section" style="text-align:center">
    <div class="container" style="max-width:600px">
      <h2 style="font-size:clamp(1.5rem,3vw,2rem);font-weight:900;margin-bottom:var(--space-4)">{{ 'جاهز للتسوق؟' | trans }}</h2>
      <p style="color:var(--color-text-muted);margin-bottom:var(--space-6)">{{ 'اكتشف آلاف المنتجات المختارة بعناية لك' | trans }}</p>
      <a href="{{ store.urls.products }}" class="btn btn--primary btn--lg">{{ 'تسوق الآن' | trans }}</a>
    </div>
  </section>

{% endblock %}
