{# Site Footer — فوتر الموقع #}

{# Newsletter Section #}
{% if settings.show_newsletter %}
  {% include 'sections/newsletter' %}
{% endif %}

<footer class="site-footer" role="contentinfo">
  <div class="container">

    {# Main Footer #}
    <div class="site-footer__main">

      {# Brand Column #}
      <div>
        <a href="{{ store.url }}" aria-label="{{ store.name }}">
          {% if store.logo %}
            <img src="{{ store.logo }}" alt="{{ store.name }}" height="48" loading="lazy">
          {% else %}
            <span style="font-size:1.5rem;font-weight:900;color:#fff">{{ store.name }}</span>
          {% endif %}
        </a>

        {% if store.description %}
          <p>{{ store.description }}</p>
        {% endif %}

        {# Social Media Icons #}
        <div class="site-footer__social">
          {% if store.social.instagram %}
            <a href="{{ store.social.instagram }}" target="_blank" rel="noopener" aria-label="Instagram">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" width="18" height="18" aria-hidden="true">
                <rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><circle cx="12" cy="12" r="5"/>
                <circle cx="17.5" cy="6.5" r=".5" fill="currentColor"/>
              </svg>
            </a>
          {% endif %}
          {% if store.social.twitter %}
            <a href="{{ store.social.twitter }}" target="_blank" rel="noopener" aria-label="X / Twitter">
              <svg viewBox="0 0 24 24" fill="currentColor" width="18" height="18" aria-hidden="true">
                <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
              </svg>
            </a>
          {% endif %}
          {% if store.social.snapchat %}
            <a href="{{ store.social.snapchat }}" target="_blank" rel="noopener" aria-label="Snapchat">
              <svg viewBox="0 0 24 24" fill="currentColor" width="18" height="18" aria-hidden="true">
                <path d="M12.166 2c.985 0 4.281.272 5.885 3.769.554 1.195.42 3.235.336 4.567l-.01.14c.26.13.574.185.965.185.308 0 .697-.072 1.067-.265.156-.08.33-.12.498-.12.35 0 .67.155.83.39.148.22.155.5.02.76-.22.434-.727.73-1.392.826-.15.02-.31.04-.477.065-1 .145-1.584.476-1.762 1.01l-.012.04c-.155.468.007.94.5 1.445.26.267.517.505.765.732.636.584 1.18 1.084 1.438 1.793.118.32.09.646-.083.912-.283.432-.8.578-1.24.578-.19 0-.37-.03-.52-.09a8.16 8.16 0 0 1-.66-.31c-.29-.15-.62-.3-.99-.3-.16 0-.32.02-.48.07-.54.15-1.1.48-1.64.77-.65.36-1.32.73-2.07.73s-1.42-.37-2.07-.73c-.54-.29-1.1-.62-1.64-.77a1.79 1.79 0 0 0-.48-.07c-.37 0-.7.15-.99.3-.21.11-.44.22-.66.31-.15.06-.33.09-.52.09-.44 0-.957-.146-1.24-.578-.173-.266-.2-.592-.083-.912.258-.71.8-1.21 1.437-1.793.249-.227.506-.465.766-.732.493-.505.655-.977.5-1.445l-.012-.04c-.178-.534-.762-.865-1.762-1.01-.167-.025-.327-.045-.477-.065-.665-.096-1.172-.392-1.393-.826-.135-.26-.128-.54.02-.76.16-.235.48-.39.83-.39.168 0 .342.04.498.12.37.193.759.265 1.067.265.391 0 .705-.055.966-.185l-.011-.14c-.085-1.332-.218-3.372.336-4.567C7.88 2.272 11.18 2 12.166 2z"/>
              </svg>
            </a>
          {% endif %}
          {% if store.social.tiktok %}
            <a href="{{ store.social.tiktok }}" target="_blank" rel="noopener" aria-label="TikTok">
              <svg viewBox="0 0 24 24" fill="currentColor" width="18" height="18" aria-hidden="true">
                <path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-2.88 2.5 2.89 2.89 0 0 1-2.89-2.89 2.89 2.89 0 0 1 2.89-2.89c.28 0 .54.04.79.1V9.01a6.33 6.33 0 0 0-.79-.05 6.34 6.34 0 0 0-6.34 6.34 6.34 6.34 0 0 0 6.34 6.34 6.34 6.34 0 0 0 6.33-6.34V9.96a8.27 8.27 0 0 0 4.84 1.56V8.07a4.85 4.85 0 0 1-1.07-.38z"/>
              </svg>
            </a>
          {% endif %}
          {% if store.social.youtube %}
            <a href="{{ store.social.youtube }}" target="_blank" rel="noopener" aria-label="YouTube">
              <svg viewBox="0 0 24 24" fill="currentColor" width="18" height="18" aria-hidden="true">
                <path d="M22.54 6.42a2.78 2.78 0 0 0-1.95-1.96C18.88 4 12 4 12 4s-6.88 0-8.59.46A2.78 2.78 0 0 0 1.46 6.42 29 29 0 0 0 1 12a29 29 0 0 0 .46 5.58a2.78 2.78 0 0 0 1.95 1.96C5.12 20 12 20 12 20s6.88 0 8.59-.46a2.78 2.78 0 0 0 1.95-1.96A29 29 0 0 0 23 12a29 29 0 0 0-.46-5.58zM9.75 15.02V8.98l5.73 3.02-5.73 3.02z"/>
              </svg>
            </a>
          {% endif %}
        </div>
      </div>

      {# Quick Links Column #}
      <div class="site-footer__nav-column">
        <h4>{{ 'روابط سريعة' | trans }}</h4>
        <ul role="list">
          {% for item in menus.footer.items | slice(0, 6) %}
            <li><a href="{{ item.url }}">{{ item.name }}</a></li>
          {% endfor %}
        </ul>
      </div>

      {# Information Column #}
      <div class="site-footer__nav-column">
        <h4>{{ 'معلومات' | trans }}</h4>
        <ul role="list">
          <li><a href="{{ store.urls.about }}">{{ 'عن المتجر' | trans }}</a></li>
          <li><a href="{{ store.urls.privacy }}">{{ 'سياسة الخصوصية' | trans }}</a></li>
          <li><a href="{{ store.urls.terms }}">{{ 'الشروط والأحكام' | trans }}</a></li>
          <li><a href="{{ store.urls.refund }}">{{ 'سياسة الإرجاع' | trans }}</a></li>
          <li><a href="{{ store.urls.faq }}">{{ 'الأسئلة الشائعة' | trans }}</a></li>
          <li><a href="{{ store.urls.blog }}">{{ 'المدونة' | trans }}</a></li>
        </ul>
      </div>

      {# Contact Column #}
      <div class="site-footer__nav-column">
        <h4>{{ 'تواصل معنا' | trans }}</h4>
        <ul class="site-footer__contact" role="list">
          {% if store.phone %}
            <li>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12 19.79 19.79 0 0 1 1.61 3.41 2 2 0 0 1 3.59 1.23h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 8.91a16 16 0 0 0 6 6l.91-.91a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z" stroke-linecap="round"/>
              </svg>
              <a href="tel:{{ store.phone }}">{{ store.phone }}</a>
            </li>
          {% endif %}
          {% if store.email %}
            <li>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z" stroke-linecap="round"/>
                <polyline points="22,6 12,13 2,6"/>
              </svg>
              <a href="mailto:{{ store.email }}">{{ store.email }}</a>
            </li>
          {% endif %}
          {% if store.address %}
            <li>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                <path d="M21 10c0 7-9 13-9 13S3 17 3 10a9 9 0 0 1 18 0z" stroke-linecap="round"/>
                <circle cx="12" cy="10" r="3"/>
              </svg>
              <span>{{ store.address }}</span>
            </li>
          {% endif %}
        </ul>
      </div>

    </div>{# /.site-footer__main #}

    {# Footer Bottom #}
    <div class="site-footer__bottom">
      <p>{{ settings.footer_copyright | default('© ' ~ 'now' | date('Y') ~ ' ' ~ store.name ~ '. جميع الحقوق محفوظة.') }}</p>

      {# Payment Icons #}
      {% if settings.show_payment_icons %}
        <div class="site-footer__payment" aria-label="{{ 'طرق الدفع المقبولة' | trans }}">
          <img src="{{ theme.url }}/assets/images/payment/mada.svg"      alt="مدى"       height="28" loading="lazy">
          <img src="{{ theme.url }}/assets/images/payment/stcpay.svg"    alt="STC Pay"   height="28" loading="lazy">
          <img src="{{ theme.url }}/assets/images/payment/applepay.svg"  alt="Apple Pay" height="28" loading="lazy">
          <img src="{{ theme.url }}/assets/images/payment/visa.svg"      alt="Visa"      height="28" loading="lazy">
          <img src="{{ theme.url }}/assets/images/payment/mastercard.svg" alt="Mastercard" height="28" loading="lazy">
          {% if settings.show_tabby %}
            <img src="{{ theme.url }}/assets/images/payment/tabby.svg"   alt="Tabby"     height="28" loading="lazy">
          {% endif %}
          {% if settings.show_tamara %}
            <img src="{{ theme.url }}/assets/images/payment/tamara.svg"  alt="Tamara"    height="28" loading="lazy">
          {% endif %}
        </div>
      {% endif %}

      {# Security badges #}
      <div class="site-footer__security">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" width="20" height="20" aria-hidden="true">
          <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        <span>{{ 'دفع آمن ومشفر' | trans }}</span>
      </div>
    </div>

  </div>{# /.container #}
</footer>
